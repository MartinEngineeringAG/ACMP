<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Build">
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>ACMP</AssemblyName>
    <RootNamespace>ACMP</RootNamespace>
    <MinVerTagPrefix>acmp-v</MinVerTagPrefix>
    <MinVerVersionOverride Condition="'$(AcmpVersionOverride)' != ''">$(AcmpVersionOverride)</MinVerVersionOverride>
  </PropertyGroup>

  <PropertyGroup Label="NuGet package">
    <PackageId>ACMP</PackageId>
    <Title>ACMP</Title>
    <Authors>Martin Engineering AG</Authors>
    <Copyright>Copyright © 2026 Martin Engineering AG</Copyright>
    <Description>A typed .NET client for the ALSO Cloud Marketplace Simple API.</Description>
    <PackageTags>ALSO;ALSOMarketplace;ALSOCloudMarketplace</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/MartinEngineeringAG/ACMP</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MartinEngineeringAG/ACMP</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
